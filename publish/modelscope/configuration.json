        "data/processed/championships.parquet",
        "data/processed/frozen_stats.json",
        "data/processed/manifest.json",
        "data/processed/reconciliation.json",
        "data/splits/train_ids.parquet",
        "data/splits/val_ids.parquet",
        "data/splits/test_ids.parquet",
        "data/splits/person_history.parquet",
